@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Lumix • Cadastro</title>

    <link rel="stylesheet"
          href="~/css/login.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

</head>

<body>

    <div class="background"></div>

    <div class="background-overlay"></div>

    <div class="page">

        <!-- ESQUERDA -->

        <div class="welcome-side">

            <img src="/images/logo.png"
                 class="hero-logo">

            <div class="welcome-content">

                <span class="tag">
                    SUA JORNADA COMEÇA AQUI
                </span>

                <h1>
                    Crie sua conta e entre no universo Lumix.
                </h1>

                <p>
                    Assista trailers cinematográficos,
                    salve seus filmes favoritos
                    e viva uma experiência moderna de streaming
                    desenvolvida para fãs de entretenimento.
                </p>

                <div class="features">

                    <div class="feature">
                        <span>✔</span>
                        Favoritos sincronizados na nuvem
                    </div>

                    <div class="feature">
                        <span>✔</span>
                        Interface inspirada nos maiores streamings
                    </div>

                    <div class="feature">
                        <span>✔</span>
                        Descoberta inteligente de filmes
                    </div>

                </div>

            </div>

        </div>

        <!-- CADASTRO -->

        <div class="login-side">

            <div class="login-box">

                <div class="login-header">

                    <h2>
                        Criar conta
                    </h2>

                    <p>
                        Cadastre-se para começar sua experiência
                    </p>

                </div>

                <form method="post">

                    <div class="input-group">

                        <label>
                            Nome completo
                        </label>

                        <input type="text"
                               name="Nome"
                               placeholder="Digite seu nome"
                               required>

                    </div>

                    <div class="input-group">

                        <label>
                            Email
                        </label>

                        <input type="email"
                               name="Email"
                               placeholder="Digite seu email"
                               required>

                    </div>

                    <div class="input-group">

                        <label>
                            Senha
                        </label>

                        <input type="password"
                               name="Senha"
                               placeholder="Crie uma senha"
                               required>

                    </div>

                    <label class="terms">

                        <input type="checkbox"
                               required>

                        <span>
                            Li e aceito os
                            <a href="#">
                                Termos de Uso
                            </a>
                            e a
                            <a href="#">
                                Política de Privacidade
                            </a>
                            conforme a LGPD.
                        </span>

                    </label>

                    <button class="btn-login">
                        Criar minha conta
                    </button>

                </form>

                <div class="divider">
                    <span>
                        ou
                    </span>
                </div>

                <a href="/Auth/Login"
                   class="btn-register">

                    Já tenho uma conta

                </a>

                <div class="lgpd">

                    Seus dados são protegidos e utilizados
                    apenas para autenticação e personalização
                    da sua experiência na plataforma.

                </div>

            </div>

        </div>

    </div>

</body>

</html>