@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Lumix • Entrar</title>

    <link rel="stylesheet"
          href="~/css/login.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

</head>

<body>

    <div class="background"></div>

    <div class="background-overlay"></div>

    <div class="page">

        <!-- LADO ESQUERDO -->

        <div class="welcome-side">

            <img src="/images/logo.png"
                 class="hero-logo">

            <div class="welcome-content">

                <span class="tag">
                    STREAMING PREMIUM
                </span>

                <h1>
                    Viva o cinema em casa!
                </h1>

                <p>
                    Descubra os maiores lançamentos do mundo
                    do entretenimento em uma interface moderna,
                    rápida e imersiva inspirada nas principais
                    plataformas de streaming.
                </p>

                <div class="features">

                    <div class="feature">
                        <span>✔</span>
                        Favoritos sincronizados
                    </div>

                    <div class="feature">
                        <span>✔</span>
                        Trailer automático em tela cheia
                    </div>

                    <div class="feature">
                        <span>✔</span>
                        Catálogo atualizado diariamente
                    </div>

                </div>

            </div>

        </div>

        <!-- LOGIN -->

        <div class="login-side">

            <div class="login-box">

                <div class="login-header">

                    <h2>
                        Bem-vindo de volta
                    </h2>

                    <p>
                        Entre na sua conta para continuar assistindo
                    </p>

                </div>

                <form method="post">

                    <div class="input-group">

                        <label>
                            Email
                        </label>

                        <input type="email"
                               name="email"
                               placeholder="Digite seu email"
                               required>

                    </div>

                    <div class="input-group">

                        <label>
                            Senha
                        </label>

                        <input type="password"
                               name="senha"
                               placeholder="Digite sua senha"
                               required>

                    </div>

                    <div class="login-options">

                        <label class="remember">

                            <input type="checkbox">

                            <span>
                                Manter conectado
                            </span>

                        </label>

                        <a href="#"
                           class="forgot">
                            Esqueci minha senha
                        </a>

                    </div>

                    <button class="btn-login">
                        Entrar na plataforma
                    </button>

                </form>

                <div class="divider">
                    <span>
                        ou
                    </span>
                </div>

                <a href="/Auth/Register"
                   class="btn-register">

                    Criar nova conta

                </a>

                <div class="lgpd">

                    Ao continuar, você concorda com nossos

                    <a href="#">
                        Termos de Uso
                    </a>

                    e

                    <a href="#">
                        Política de Privacidade
                    </a>.

                </div>

            </div>

        </div>

    </div>

</body>

</html>