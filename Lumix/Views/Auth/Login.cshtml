@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Lumix • Entrar</title>

    <link rel="stylesheet"
          href="~/css/login.css">

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap"
          rel="stylesheet">

    <style>
            /* BOTÃO ESQUECI SENHA */
            .forgot-btn {
                background: none;
                border: none;
                color: #b983ff;
                cursor: pointer;
                font-size: 14px;
                font-weight: 500;
                transition: .3s;
                font-family: 'Poppins', sans-serif;
            }

                .forgot-btn:hover {
                    color: #d0a7ff;
                }

            /* MODAL */
            .forgot-modal {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.75);
                backdrop-filter: blur(6px);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                pointer-events: none;
                transition: .3s;
                z-index: 999999;
            }

                .forgot-modal.active {
                    opacity: 1;
                    pointer-events: all;
                }

            .forgot-box {
                width: 100%;
                max-width: 430px;
                background: #121212;
                border: 1px solid rgba(255,255,255,.08);
                border-radius: 24px;
                padding: 35px;
                position: relative;
                animation: modalShow .3s ease; /* A animação é chamada aqui, mas roda a partir do login.css */
            }

            .close-modal {
                position: absolute;
                top: 15px;
                right: 15px;
                width: 40px;
                height: 40px;
                border: none;
                border-radius: 50%;
                background: rgba(255,255,255,.08);
                color: white;
                font-size: 18px;
                cursor: pointer;
                transition: .3s;
            }

                .close-modal:hover {
                    background: rgba(255,255,255,.15);
                }

            .forgot-box h2 {
                color: white;
                font-size: 30px;
                margin-bottom: 10px;
            }

            .forgot-box p {
                color: #bdbdbd;
                line-height: 1.6;
                margin-bottom: 25px;
            }

            .forgot-box input {
                width: 100%;
                height: 55px;
                border: none;
                outline: none;
                border-radius: 14px;
                background: rgba(255,255,255,.06);
                color: white;
                padding: 0 18px;
                font-size: 15px;
                margin-bottom: 18px;
            }

            .forgot-submit {
                width: 100%;
                height: 55px;
                border: none;
                border-radius: 14px;
                background: #7b2cbf;
                color: white;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .3s;
            }

                .forgot-submit:hover {
                    background: #9d4edd;
                }
    </style>

</head>

<body>

    <div class="background"></div>

    <div class="background-overlay"></div>

    <div class="page">

        <div class="welcome-side">

            <img src="/images/logo.png"
                 class="hero-logo">

            <div class="welcome-content">

                <span class="tag">
                    STREAMING PREMIUM
                </span>

                <h1>
                    Viva o cinema em casa!
                </h1>

                <p>
                    Descubra os maiores lançamentos do mundo
                    do entretenimento em uma interface moderna,
                    rápida e imersiva inspirada nas principais
                    plataformas de streaming.
                </p>

                <div class="features">

                    <div class="feature">
                        <span>✔</span>
                        Favoritos sincronizados
                    </div>

                    <div class="feature">
                        <span>✔</span>
                        Trailer automático em tela cheia
                    </div>

                    <div class="feature">
                        <span>✔</span>
                        Catálogo atualizado diariamente
                    </div>

                </div>

            </div>

        </div>

        <div class="login-side">

            <div class="login-box">

                <div class="login-header">

                    <h2>
                        Bem-vindo de volta
                    </h2>

                    <p>
                        Entre na sua conta para continuar assistindo
                    </p>

                </div>

                <form method="post"
                      action="/Auth/Login">

                    <div class="input-group">

                        <label>
                            Email
                        </label>

                        <input type="email"
                               name="email"
                               placeholder="Digite seu email"
                               required>

                    </div>

                    <div class="input-group">

                        <label>
                            Senha
                        </label>

                        <input type="password"
                               name="senha"
                               placeholder="Digite sua senha"
                               required>

                    </div>

                    <div class="login-options">

                        <label class="remember">

                            <input type="checkbox">

                            <span>
                                Manter conectado
                            </span>

                        </label>

                        <button type="button"
                                class="forgot-btn"
                                onclick="abrirModalEsqueci()">

                            Esqueci minha senha

                        </button>

                    </div>

                    <button class="btn-login">
                        Entrar na plataforma
                    </button>

                </form>

                <div class="divider">
                    <span>
                        ou
                    </span>
                </div>

                <a href="/Auth/Register"
                   class="btn-register">

                    Criar nova conta

                </a>

                <div class="lgpd">

                    Ao continuar, você concorda com nossos

                    <a href="#">
                        Termos de Uso
                    </a>

                    e

                    <a href="#">
                        Política de Privacidade
                    </a>.

                </div>

            </div>

        </div>

    </div>

    <div class="forgot-modal"
         id="forgotModal">

        <div class="forgot-box">

            <button type="button"
                    class="close-modal"
                    onclick="fecharModalEsqueci()">

                ✕

            </button>

            <h2>
                Recuperar senha
            </h2>

            <p>
                Digite seu email e a nova senha.
            </p>

            <div class="input-group">

                <input type="email"
                       id="emailRecuperacao"
                       placeholder="Seu email"
                       required>

            </div>

            <div class="input-group">

                <input type="password"
                       id="novaSenha"
                       placeholder="Nova senha"
                       required>

            </div>

            <div class="input-group">

                <input type="password"
                       id="confirmarSenha"
                       placeholder="Confirmar senha"
                       required>

            </div>

            <button type="button"
                    class="btn-save-password"
                    onclick="#">

               Salvar nova senha

            </button>

        </div>

    </div>

    <script>
            function abrirModalEsqueci() {
                document
                    .getElementById("forgotModal")
                    .classList
                    .add("active");
            }

            function fecharModalEsqueci() {
                document
                    .getElementById("forgotModal")
                    .classList
                    .remove("active");
            }

            async function alterarSenha() {
                const email = document.getElementById("emailRecuperacao").value;
                const novaSenha = document.getElementById("novaSenha").value;
                const confirmarSenha = document.getElementById("confirmarSenha").value;

                if (!email || !novaSenha || !confirmarSenha) {
                    alert("Preencha todos os campos");
                    return;
                }

                if (novaSenha !== confirmarSenha) {
                    alert("As senhas não coincidem");
                    return;
                }

                const response = await fetch("/Auth/ForgotPassword", {
                    method: "POST",
                    headers: {
                        "Content-Type": "application/json"
                    },
                    body: JSON.stringify({
                        email: email,
                        novaSenha: novaSenha,
                        confirmarSenha: confirmarSenha
                    })
                });

                const resultado = await response.text();
                alert(resultado);

                if (resultado.includes("sucesso")) {
                    fecharModalEsqueci();
                }
            }
    </script>

</body>

</html>