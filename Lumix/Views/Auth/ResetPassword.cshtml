@model Lumix.Models.Usuario

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1">

    <title>Nova Senha • Lumix</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                background: #090909;
                font-family: 'Poppins', sans-serif;
                color: white;
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
            }

            .box {
                width: 100%;
                max-width: 420px;
                background: #121212;
                border-radius: 24px;
                padding: 40px;
                box-shadow: 0 20px 50px rgba(0,0,0,.6);
            }

            h1 {
                font-size: 32px;
                margin-bottom: 10px;
            }

            p {
                color: #bdbdbd;
                margin-bottom: 25px;
                line-height: 1.6;
            }

            input {
                width: 100%;
                height: 55px;
                border: none;
                outline: none;
                border-radius: 14px;
                background: rgba(255,255,255,.06);
                color: white;
                padding: 0 18px;
                font-size: 15px;
                margin-bottom: 18px;
            }

            button {
                width: 100%;
                height: 55px;
                border: none;
                border-radius: 14px;
                background: #7b2cbf;
                color: white;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .3s;
            }

                button:hover {
                    background: #9d4edd;
                }

    </style>

</head>

<body>

    <div class="box">

        <h1>
            Nova senha
        </h1>

        <p>
            Digite sua nova senha.
        </p>

        <form method="post"
              action="/Auth/ResetPassword">

            <input type="hidden"
                   name="email"
                   value="@Model.Email">

            <input type="password"
                   name="novaSenha"
                   placeholder="Digite a nova senha"
                   required>

            <button type="submit">

                Alterar senha

            </button>

        </form>

    </div>

</body>

</html>