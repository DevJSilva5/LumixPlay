@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="utf-8">

    <title>Recuperar Senha</title>

    <link rel="stylesheet"
          href="~/css/login.css">

</head>

<body>

    <div class="background"></div>

    <div class="background-overlay"></div>

    <div class="page">

        <div class="login-side"
             style="width:100%;">

            <div class="login-box">

                <div class="login-header">

                    <h2>
                        Recuperar senha
                    </h2>

                    <p>
                        Digite seu email para redefinir sua senha
                    </p>

                </div>

                <form method="post"
                      action="/Auth/ForgotPassword">

                    <div class="input-group">

                        <label>
                            Email
                        </label>

                        <input type="email"
                               name="email"
                               required>

                    </div>

                    <button class="btn-login">
                        Continuar
                    </button>

                </form>

                @if (ViewBag.Erro != null)
                {
                    <p style="
                        color:#ff4d4d;
                        margin-top:15px;
                        text-align:center;
                        ">
                        @ViewBag.Erro
                    </p>
                }

            </div>

        </div>

    </div>

</body>

</html>