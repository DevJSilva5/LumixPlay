@using System.Text.Json

@{
    Layout = null;

    var filme =
        ((JsonDocument)ViewBag.Movie).RootElement;

    string titulo = "";
    string descricao = "";
    string banner = "";
    string poster = "";
    string data = "";
    double nota = 0;
    int filmeId = 0;

    if (filme.TryGetProperty("id", out var idProp))
    {
        filmeId = idProp.GetInt32();
    }

    if (filme.TryGetProperty("title", out var titleProp))
    {
        titulo = titleProp.GetString() ?? "";
    }

    if (filme.TryGetProperty("overview", out var overviewProp))
    {
        descricao = overviewProp.GetString() ?? "";
    }

    if (filme.TryGetProperty("vote_average", out var voteProp))
    {
        nota = voteProp.GetDouble();
    }

    if (filme.TryGetProperty("backdrop_path", out var backdropProp))
    {
        banner = backdropProp.GetString() ?? "";
    }

    if (filme.TryGetProperty("poster_path", out var posterProp))
    {
        poster = posterProp.GetString() ?? "";
    }

    if (filme.TryGetProperty("release_date", out var dateProp))
    {
        data = dateProp.GetString() ?? "";
    }

    var ano =
        !string.IsNullOrEmpty(data) && data.Length >= 4
        ? data.Substring(0, 4)
        : "N/A";

    var classificacao = "14";

    string trailerKey = "";

    if (ViewBag.Videos != null)
    {
        var videosDocument =
            ((JsonDocument)ViewBag.Videos).RootElement;

        JsonElement results;

        if (videosDocument.TryGetProperty("results", out results))
        {
            foreach (var video in results.EnumerateArray())
            {
                if (
                    video.TryGetProperty("site", out var siteProp)
                    &&
                    video.TryGetProperty("type", out var typeProp)
                    &&
                    video.TryGetProperty("key", out var keyProp)
                )
                {
                    var site = siteProp.GetString();
                    var type = typeProp.GetString();

                    if (
                        site == "YouTube"
                        &&
                        type == "Trailer"
                    )
                    {
                        trailerKey =
                            keyProp.GetString() ?? "";

                        break;
                    }
                }
            }
        }
    }
}

<!DOCTYPE html>

<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>@titulo</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                overflow-x: hidden;
            }

            body {
                background: #090909;
                color: white;
                font-family: 'Poppins',sans-serif;
                overflow-x: hidden;
            }

            .hero {
                width: 100%;
                min-height: 100vh;
                position: relative;
                overflow: hidden;
                background: black;
            }

            .banner-image {
                position: absolute;
                inset: 0;
                width: 100%;
                height: 100%;
                object-fit: cover;
                z-index: 1;
                opacity: 1;
                transition: opacity 2s ease, transform 8s ease;
                transform: scale(1);
            }

            .trailer-video {
                position: absolute;
                top: 50%;
                left: 50%;
                width: 100vw;
                height: 56.25vw;
                min-height: 100vh;
                min-width: 177.77vh;
                transform: translate(-50%,-50%);
                border: none;
                pointer-events: none;
                opacity: 0;
                z-index: 2;
                transition: opacity 2s ease;
                filter: brightness(.9) contrast(1.05) saturate(1.05);
            }

            .overlay {
                position: absolute;
                inset: 0;
                z-index: 3;
                background: linear-gradient( to right, rgba(0,0,0,0.95) 20%, rgba(0,0,0,0.5) 60%, rgba(0,0,0,0.9) ), linear-gradient( to top, #090909, transparent 40% );
            }

            .content {
                position: absolute;
                z-index: 10;
                top: 50%;
                transform: translateY(-50%);
                left: 70px;
                max-width: 650px;
                width: 100%;
                padding-right: 30px;
            }

            .title {
                font-size: 70px;
                font-weight: 700;
                margin-bottom: 20px;
                line-height: 1.05;
            }

            .meta {
                display: flex;
                align-items: center;
                flex-wrap: wrap;
                gap: 20px;
                margin-bottom: 25px;
                color: #cfcfcf;
                font-size: 17px;
            }

            .rating {
                color: #46d369;
                font-weight: 600;
            }

            .description {
                font-size: 18px;
                line-height: 1.8;
                color: #e4e4e4;
                margin-bottom: 35px;
            }

            .buttons {
                display: flex;
                gap: 15px;
                flex-wrap: wrap;
            }

            .btn {
                padding: 15px 28px;
                border: none;
                border-radius: 10px;
                font-size: 17px;
                font-weight: 600;
                cursor: pointer;
                transition: .3s;
            }

            .play {
                background: white;
                color: black;
            }

                .play:hover {
                    transform: scale(1.05);
                }

            .back {
                background: rgba(255,255,255,.15);
                color: white;
            }

                .back:hover {
                    background: rgba(255,255,255,.25);
                }

            .favorite-btn {
                background: none;
                border: none;
                outline: none;
                color: white;
                font-size: 34px;
                cursor: pointer;
                transition: .3s;
                margin-left: 5px;
            }

                .favorite-btn:hover {
                    transform: scale(1.15);
                }

                .favorite-btn.active {
                    color: #ff1e56;
                    text-shadow: 0 0 10px rgba(255,30,86,.8), 0 0 25px rgba(255,30,86,.5);
                }

            img,
            video,
            iframe {
                max-width: 100%;
            }

            @@media(max-width:1024px) {

                .content {
                    left: 40px;
                    max-width: 600px;
                }

                .title {
                    font-size: 56px;
                }

                .description {
                    font-size: 16px;
                }
            }

            @@media(max-width:768px) {

                .hero {
                    min-height: 100vh;
                }

                .overlay {
                    background: linear-gradient( to top, rgba(0,0,0,0.98), rgba(0,0,0,0.55) );
                }

                .content {
                    position: relative;
                    top: auto;
                    margin-top: 180px;
                    left: auto;
                    transform: none;
                    width: 100%;
                    padding: 110px 20px 50px;
                }

                .title {
                    font-size: 38px;
                    line-height: 1.1;
                    margin-bottom: 18px;
                }

                .meta {
                    gap: 12px;
                    font-size: 14px;
                    margin-bottom: 20px;
                }

                .description {
                    font-size: 15px;
                    line-height: 1.7;
                    margin-bottom: 30px;
                }

                .buttons {
                    flex-direction: column;
                }

                .btn {
                    width: 100%;
                    font-size: 15px;
                    padding: 15px;
                }

                .favorite-btn {
                    font-size: 30px;
                }

                .trailer-video {
                    display: none;
                }
            }

            @@media(max-width:480px) {

                .content {
                    padding: 100px 16px 40px;
                    
                }

                .title {
                    font-size: 32px;
                }

                .description {
                    font-size: 14px;
                }

                .meta {
                    font-size: 13px;
                }

                .trailer-video {
                    display: none;
                }
            }

    </style>

</head>

<body>

    <div class="hero">

        @if (!string.IsNullOrEmpty(trailerKey))
        {
            <img id="bannerImage"
                 class="banner-image"
                 src="https://image.tmdb.org/t/p/original@(banner)">

            <iframe id="trailer"
                    class="trailer-video"
                    src="https://www.youtube.com/embed/@trailerKey?autoplay=1&mute=1&cc_load_policy=0&cc_lang_pref=pt&controls=0&disablekb=1&fs=0&iv_load_policy=3&modestbranding=1&rel=0&playsinline=1&loop=1&playlist=@trailerKey&vq=highres"
                    title="@titulo"
                    allow="autoplay; encrypted-media">
            </iframe>
        }
        else
        {
            <img class="banner-image"
                 src="https://image.tmdb.org/t/p/original@(banner)">
        }

        <div class="overlay"></div>

        <div class="content">

            <div class="title">
                @titulo
            </div>

            <div class="meta">

                <div class="rating">
                    ★ @nota.ToString("0.0")
                </div>

                <div>
                    @ano
                </div>

                <div>
                    +@classificacao
                </div>

                <button id="favoriteBtn"
                        class="favorite-btn @(ViewBag.Favoritado ? "active" : "")"
                        onclick="toggleFavorito()">

                    ♥

                </button>

            </div>

            <div class="description">
                @descricao
            </div>

            <div class="buttons">

                <button class="btn play">
                    ▶ Assistir
                </button>

                <button class="btn back"
                        onclick="history.back()">
                    ← Voltar
                </button>

            </div>

        </div>

    </div>

    <script>

            window.addEventListener("load", () => {

                const trailer =
                    document.getElementById("trailer");

                if(trailer){

                    setTimeout(() => {

                        trailer.style.opacity = "1";

                    }, 5000);

                }

            });

    </script>

    <script>

            async function toggleFavorito() {

                const button =
                    document.getElementById("favoriteBtn");

                const response =
                    await fetch('/Movie/ToggleFavoritoAjax', {

                        method: 'POST',

                        headers: {
                            'Content-Type': 'application/json'
                        },

                        body: JSON.stringify({

                            filmeId: @filmeId,

                            titulo: '@Html.Raw(titulo.Replace("'", "\\'"))',

                            poster: '@poster'
                        })
                    });

                const data = await response.json();

                if (data.favoritado) {

                    button.classList.add("active");

                } else {

                    button.classList.remove("active");
                }

                localStorage.setItem(
                    "favoritosUpdated",
                    Date.now()
                );
            }

    </script>

</body>

</html>