@{
    Layout = null;

    var usuario = Context.Session.GetString("Usuario") ?? "Usuário";

    var email = Context.Session.GetString("Email") ?? "email@lumix.com";

    var fotoPerfil = Context.Session.GetString("FotoPerfil");

    if (string.IsNullOrEmpty(fotoPerfil))
    {
        fotoPerfil = "/images/perfil-default.png";
    }
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Perfil - Lumix</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            body {
                font-family: 'Poppins', sans-serif;
                background: #090909;
                color: white;
                overflow-x: hidden;
            }

            a {
                text-decoration: none;
            }

            /* BACKGROUND */

            .background {
                position: fixed;
                inset: 0;
                background: linear-gradient( rgba(0,0,0,0.85), rgba(0,0,0,0.92) ), url('https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=2070&auto=format&fit=crop');
                background-size: cover;
                background-position: center;
                z-index: -1;
            }

            /* NAVBAR */

            .navbar {
                width: 100%;
                background: rgba(0,0,0,0.75);
                backdrop-filter: blur(8px);
                border-bottom: 2px solid #7b2cbf;
                display: flex;
                align-items: center;
                justify-content: space-between;
                min-height: 80px;
                padding: 0 clamp(15px,4vw,60px);
                position: fixed;
                top: 0;
                z-index: 9999;
            }

            .logo img {
                width: 210px;
            }

            .back-btn {
                color: white;
                background: rgba(255,255,255,0.08);
                padding: 12px 20px;
                border-radius: 12px;
                transition: 0.3s;
                font-weight: 500;
            }

                .back-btn:hover {
                    background: #7b2cbf;
                    transform: scale(1.05);
                }

            /* CONTAINER */

            .profile-container {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                padding: 140px 20px 40px;
            }

            /* CARD */

            .profile-card {
                width: 95%;
                max-width: 550px;
                background: rgba(15,15,15,0.88);
                border: 2px solid rgba(123,44,191,0.5);
                backdrop-filter: blur(12px);
                border-radius: 28px;
                padding: 45px;
                text-align: center;
                box-shadow: 0 20px 60px rgba(0,0,0,0.7);
                position: relative;
                overflow: hidden;
            }

                .profile-card::before {
                    content: "";
                    position: absolute;
                    width: 350px;
                    height: 350px;
                    background: rgba(123,44,191,0.15);
                    border-radius: 50%;
                    top: -180px;
                    right: -120px;
                    filter: blur(10px);
                }

            /* FOTO */

            .profile-photo-area {
                position: relative;
                width: fit-content;
                margin: auto;
            }

            .profile-photo {
                width: 170px;
                height: 170px;
                border-radius: 50%;
                object-fit: cover;
                border: 5px solid #9d4edd;
                box-shadow: 0 15px 40px rgba(157,78,221,0.4);
                transition: 0.3s;
            }

                .profile-photo:hover {
                    transform: scale(1.04);
                }

            /* NOME */

            .profile-name {
                font-size: 38px;
                font-weight: 700;
                margin-top: 28px;
                color: white;
            }

            .profile-email {
                margin-top: 8px;
                color: #bdbdbd;
                font-size: 17px;
            }

            /* INFO */

            .info-area {
                margin-top: 40px;
                display: flex;
                flex-direction: column;
                gap: 18px;
            }

            .info-box {
                background: rgba(255,255,255,0.05);
                border: 1px solid rgba(255,255,255,0.08);
                border-radius: 18px;
                padding: 20px;
                text-align: left;
                transition: 0.3s;
            }

                .info-box:hover {
                    border-color: #9d4edd;
                    transform: translateY(-3px);
                }

            .info-label {
                color: #c77dff;
                font-size: 14px;
                margin-bottom: 6px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .info-value {
                font-size: 18px;
                font-weight: 500;
                color: white;
            }

            /* BOTÕES */

            .buttons {
                margin-top: 35px;
                display: flex;
                gap: 16px;
            }

            .btn {
                flex: 1;
                height: 55px;
                border: none;
                border-radius: 16px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: 0.3s;
            }

            .edit-btn {
                background: #7b2cbf;
                color: white;
            }

                .edit-btn:hover {
                    background: #9d4edd;
                    transform: scale(1.03);
                }

            .logout-btn {
                background: rgba(255,255,255,0.08);
                color: white;
                border: 1px solid rgba(255,255,255,0.08);
            }

                .logout-btn:hover {
                    background: #d62828;
                    border-color: #d62828;
                    transform: scale(1.03);
                }

            /* RESPONSIVO */

            @@media(max-width: 700px) {

                .profile-card {
                    padding: 35px 25px;
                }

                .buttons {
                    flex-direction: column;
                }

                .profile-name {
                    font-size: 30px;
                }

                .navbar {
                    padding: 0 20px;
                }

                .logo img {
                    width: 170px;
                }
            }

            /* MODAL */

            .modal-overlay {
                position: fixed;
                inset: 0;
                background: rgba(0,0,0,.75);
                backdrop-filter: blur(8px);
                display: flex;
                align-items: center;
                justify-content: center;
                opacity: 0;
                pointer-events: none;
                transition: .3s;
                z-index: 999999;
            }

                .modal-overlay.active {
                    opacity: 1;
                    pointer-events: all;
                }

            .modal-box {
                width: 100%;
                max-width: 500px;
                background: #121212;
                border: 2px solid #7b2cbf;
                border-radius: 25px;
                padding: 35px;
                box-shadow: 0 20px 60px rgba(0,0,0,.7);
            }

            .modal-title {
                font-size: 30px;
                font-weight: 700;
                margin-bottom: 25px;
                text-align: center;
            }

            .input-group {
                margin-bottom: 20px;
            }

                .input-group label {
                    display: block;
                    margin-bottom: 8px;
                    color: #c77dff;
                    font-size: 14px;
                    font-weight: 600;
                }

                .input-group input {
                    width: 100%;
                    height: 55px;
                    border: none;
                    outline: none;
                    border-radius: 14px;
                    background: #1b1b1b;
                    color: white;
                    padding: 0 18px;
                    font-size: 16px;
                    border: 1px solid transparent;
                    transition: .3s;
                }

                    .input-group input:focus {
                        border-color: #9d4edd;
                        box-shadow: 0 0 15px rgba(157,78,221,.3);
                    }

            .preview-photo {
                width: 120px;
                height: 120px;
                border-radius: 50%;
                object-fit: cover;
                display: block;
                margin: 10px auto 25px;
                border: 4px solid #9d4edd;
            }

            .modal-buttons {
                display: flex;
                gap: 15px;
            }

            .cancel-btn,
            .save-btn {
                flex: 1;
                height: 52px;
                border: none;
                border-radius: 14px;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .3s;
            }

            .cancel-btn {
                background: #252525;
                color: white;
            }

                .cancel-btn:hover {
                    background: #333;
                }

            .save-btn {
                background: #7b2cbf;
                color: white;
            }

                .save-btn:hover {
                    background: #9d4edd;
                    transform: scale(1.03);
                }

            /* RESPONSIVIDADE GLOBAL */

            img,
            video,
            iframe {
                max-width: 100%;
            }

            body {
                overflow-x: hidden;
            }

            /* TABLET */

            @@media(max-width:1024px) {

                .content {
                    padding: 0 20px;
                }
            }

            /* MOBILE */

            @@media(max-width:768px) {

                h1 {
                    font-size: 32px !important;
                }

                h2 {
                    font-size: 26px !important;
                }

                h3 {
                    font-size: 22px !important;
                }

                p {
                    font-size: 15px !important;
                }

                .buttons {
                    flex-direction: column;
                }

                .btn {
                    width: 100%;
                }
                
                .profile-container{
                    padding-top:120px;
                }

                .profile-photo{
                    width:120px;
                    height:120px;
                }

                .profile-name{
                    font-size:28px;
                }

                .buttons{
                    flex-direction:column;
                }
            }

    </style>

</head>

<body>

    <div class="background"></div>

    <!-- NAVBAR -->

    <div class="navbar">

        <div class="logo">
            <img src="/images/logo.png">
        </div>

        <a href="/Home/Index"
               class="back-btn">

            ← Voltar
        </a>

    </div>

    <!-- PROFILE -->

    <div class="profile-container">

        <div class="profile-card">


            <div class="profile-photo-area">

                <img src="@(string.IsNullOrEmpty(fotoPerfil)
                                         ? "/images/perfil-default.png"
                                         : fotoPerfil)"
                     class="profile-photo">

            </div>

            <div class="profile-name">
                @usuario
            </div>

            <div class="profile-email">
                @email
            </div>

            <div class="info-area">

                <div class="info-box">

                    <div class="info-label">
                        Usuário
                    </div>

                    <div class="info-value">
                        @usuario
                    </div>

                </div>

                <div class="info-box">

                    <div class="info-label">
                        Email
                    </div>

                    <div class="info-value">
                        @email
                    </div>

                </div>

            </div>

            <div class="buttons">

                <button class="btn edit-btn"
                        onclick="abrirModal()">

                    Editar Perfil

                </button>

                <a href="/Auth/Logout"
                       style="flex:1;">

                    <button class="btn logout-btn"
                            style="width:100%;">

                        Sair

                    </button>

                </a>

            </div>

        </div>
        <!-- MODAL -->

        <div class="modal-overlay"
             id="modalOverlay">

            <div class="modal-box">

                <div class="modal-title">
                    Editar Perfil
                </div>

                <form method="post"
                      action="/Profile/Editar"
                      enctype="multipart/form-data">

                    <div class="input-group">

                        <label>
                            Nome
                        </label>

                        <input type="text"
                               name="nome"
                               value="@usuario">

                    </div>

                    <div class="input-group">

                        <label>
                            Foto de Perfil
                        </label>

                        <input type="file"
                               name="foto"
                               accept="image/*"
                               onchange="previewArquivo(event)">
                    </div>

                    <img src="@fotoPerfil"
                         id="preview"
                         class="preview-photo">

                    <div class="modal-buttons">

                        <button type="button"
                                class="cancel-btn"
                                onclick="fecharModal()">

                            Cancelar

                        </button>

                        <button type="submit"
                                class="save-btn">

                            Salvar

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

    <script>

            function abrirModal() {

                document
                    .getElementById("modalOverlay")
                    .classList
                    .add("active");
            }

            function fecharModal() {

                document
                    .getElementById("modalOverlay")
                    .classList
                    .remove("active");
            }

            function previewArquivo(event) {

                const imagem =
                    document.getElementById("preview");

                imagem.src =
                    URL.createObjectURL(
                        event.target.files[0]
                    );
            }

    </script>

</body>

</html>