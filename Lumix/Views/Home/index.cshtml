@using System.Text.Json

@{
    Layout = null;
    ViewData["Title"] = "Lumix";

    var populares = ((JsonDocument)ViewBag.Populares)
        .RootElement
        .GetProperty("results");

    var acao = ((JsonDocument)ViewBag.Acao)
        .RootElement
        .GetProperty("results");

    var romance = ((JsonDocument)ViewBag.Romance)
        .RootElement
        .GetProperty("results");

    var comedia = ((JsonDocument)ViewBag.Comedia)
        .RootElement
        .GetProperty("results");

    var favoritos =
    ViewBag.Favoritos as List<Lumix.Models.Favorito>;

    var usuario = Context.Session.GetString("Usuario") ?? "Usuário";

    var fotoPerfil = Context.Session.GetString("FotoPerfil");

    if (string.IsNullOrEmpty(fotoPerfil))
    {
        fotoPerfil = "/images/perfil-default.png";
    }
}

<!DOCTYPE html>
<html lang="pt-br">

<head>

    <meta charset="UTF-8">

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0">

    <title>Lumix</title>

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet">

    <style>

        *{
            margin:0;
            padding:0;
            box-sizing:border-box;
        }

        html{
            overflow-x:hidden;
        }

        body{
            background:#090909;
            color:white;
            font-family:'Poppins',sans-serif;
            overflow-x:hidden;
        }

        a{
            text-decoration:none;
        }

        /* NAVBAR */

        .navbar{
            width:100%;
            background:rgba(10,10,10,0.95);
            backdrop-filter:blur(8px);
            display:flex;
            align-items:center;
            justify-content:space-between;
            min-height:80px;
            padding:0 50px;
            border-bottom:2px solid #7b2cbf;
            position:fixed;
            top:0;
            z-index:999999;
        }

        .logo img{
            width:200px;
            margin-top:10px;
            object-fit:contain;
        }

        /* RIGHT */

        .navbar-right{
            display:flex;
            align-items:center;
            gap:18px;
            margin-left:auto;
        }

        /* SEARCH */

        .search-container{
            position:relative;
            display:flex;
            align-items:center;
        }

        .search-toggle{
            width:45px;
            height:45px;
            border:none;
            border-radius:50%;
            background:rgba(255,255,255,.08);
            color:white;
            cursor:pointer;
            font-size:18px;
            transition:.3s;
        }

        .search-toggle:hover{
            background:#7b2cbf;
            transform:scale(1.08);
        }

        .search-input{
            width:0;
            opacity:0;
            height:45px;
            border:none;
            outline:none;
            background:rgba(255,255,255,.08);
            color:white;
            border-radius:14px;
            margin-left:10px;
            padding:0;
            transition:.4s;
            font-size:15px;
        }

        .search-container.active .search-input{
            width:260px;
            opacity:1;
            padding:0 18px;
        }

        .search-results{
            position:absolute;
            top:60px;
            right:0;
            width:320px;
            max-height:500px;
            overflow-y:auto;
            background:#141414;
            border-radius:18px;
            display:none;
            padding:10px;
            box-shadow:0 20px 50px rgba(0,0,0,.7);
            z-index:99999;
        }

        .search-results.active{
            display:block;
        }

        .search-item{
            display:flex;
            align-items:center;
            gap:14px;
            padding:10px;
            border-radius:12px;
            transition:.25s;
        }

        .search-item:hover{
            background:rgba(255,255,255,.08);
        }

        .search-item img{
            width:55px;
            height:80px;
            object-fit:cover;
            border-radius:10px;
        }

        .search-item span{
            color:white;
            font-size:15px;
            font-weight:500;
        }

        /* PERFIL */

        .profile-area{
            display:flex;
            align-items:center;
            gap:12px;
            color:white;
            background:rgba(255,255,255,0.05);
            padding:8px 14px;
            border-radius:12px;
            transition:0.3s;
        }

        .profile-area:hover{
            background:rgba(255,255,255,0.1);
        }

        .profile-pic{
            width:42px;
            height:42px;
            border-radius:50%;
            object-fit:cover;
            border:2px solid #c77dff;
            background:#1a1a1a;
        }

        .profile-name{
            font-size:15px;
            font-weight:500;
        }

        /* MENU */

        .menu-toggle{
            display:none;
            font-size:32px;
            cursor:pointer;
            color:white;
        }

        .mobile-menu{
            position:fixed;
            top:80px;
            right:-100%;
            width:280px;
            height:calc(100vh - 80px);
            background:#121212;
            z-index:999999;
            transition:0.35s;
            padding:25px;
            border-left:2px solid #7b2cbf;
        }

        .mobile-menu.active{
            right:0;
        }

        .mobile-menu a{
            display:flex;
            align-items:center;
            gap:12px;
            color:white;
            margin-bottom:20px;
            font-size:18px;
            font-weight:500;
        }

        .mobile-profile-link{
            margin-top:25px;
        }

        /* HERO */

        .hero{
            height:88vh;
            background:
                linear-gradient(
                    to right,
                    rgba(0,0,0,0.95),
                    rgba(0,0,0,0.55)
                ),
                url('https://images.unsplash.com/photo-1517604931442-7e0c8ed2963c?q=80&w=2070&auto=format&fit=crop');

            background-size:cover;
            background-position:center;
            display:flex;
            flex-direction:column;
            justify-content:center;
            padding-left:70px;
            padding-top:80px;
        }

        .hero h1{
            font-size:78px;
            font-weight:700;
            margin-bottom:20px;
        }

        .hero p{
            width:600px;
            color:#dddddd;
            line-height:1.8;
            font-size:18px;
            margin-bottom:30px;
        }

        .btn{
            width:230px;
            padding:16px;
            border:none;
            border-radius:12px;
            background:#7b2cbf;
            color:white;
            font-size:18px;
            font-weight:600;
            cursor:pointer;
            transition:0.3s;
        }

        .btn:hover{
            background:#9d4edd;
            transform:scale(1.05);
        }

        /* SECTION */

        .section{
            padding:40px 50px;
        }

        .section-title{
            font-size:30px;
            font-weight:600;
            margin-bottom:10px;
            color:#c77dff;
        }

        /* SLIDER */

        .slider-container{
            position:relative;
        }

        .movies-row{
            display:flex;
            gap:18px;
            overflow-x:auto;
            scrollbar-width:none;
            padding:25px 10px;
            scroll-behavior:smooth;
        }

        .movies-row::-webkit-scrollbar{
            display:none;
        }

        /* CARD */

        .card{
            min-width:220px;
            flex-shrink:0;
            transition:0.35s;
            cursor:pointer;
            color:white;
        }

        .card:hover{
            transform:scale(1.05);
        }

        .card img{
            width:220px;
            height:330px;
            object-fit:cover;
            border-radius:14px;
            box-shadow:0 10px 30px rgba(0,0,0,0.5);
        }

        .card-title{
            margin-top:12px;
            font-size:16px;
            font-weight:500;
            width:220px;
            line-height:1.4;
            color:white;
        }

        /* SETAS */

        .arrow{
            position:absolute;
            top:45%;
            transform:translateY(-50%);
            width:55px;
            height:55px;
            border:none;
            border-radius:50%;
            background:rgba(0,0,0,0.85);
            color:white;
            font-size:30px;
            cursor:pointer;
            z-index:999;
        }

        .left{
            left:-5px;
        }

        .right{
            right:-5px;
        }

        /* MOBILE */

        @@media(max-width:768px){

            .navbar{
                padding:0 20px;
            }

            .logo img{
                width:150px;
            }

            .desktop-search,
            .desktop-profile{
                display:none;
            }

            .menu-toggle{
                display:block;
            }

            .mobile-search{
                margin-bottom:25px;
            }

            .mobile-search-container.active .search-input{
                width:180px;
                opacity:1;
                padding:0 18px;
            }

            .mobile-search-container .search-results{
                width:230px;
                right:0;
            }

            .hero{
                height:auto;
                min-height:75vh;
                padding:130px 20px 60px;
                text-align:center;
                align-items:center;
            }

            .hero h1{
                font-size:42px;
            }

            .hero p{
                width:100%;
                font-size:15px;
            }

            .section{
                padding:30px 15px;
            }

            .card{
                min-width:135px;
            }

            .card img{
                width:135px;
                height:205px;
            }

            .card-title{
                width:135px;
                font-size:13px;
            }

            .arrow{
                display:none;
            }
        }

    </style>

</head>

<body>

    <!-- NAVBAR -->

    <div class="navbar">

        <div class="logo">
            <img src="/images/logo.png" alt="Lumix Logo">
        </div>

        <div class="navbar-right">

            <!-- SEARCH DESKTOP -->

            <div class="search-container desktop-search">

                <button id="searchToggle"
                        class="search-toggle">

                    🔍

                </button>

                <input type="text"
                       id="searchInput"
                       class="search-input"
                       placeholder="Buscar filmes...">

                <div id="searchResults"
                     class="search-results">
                </div>

            </div>

            <!-- PERFIL -->

            <a href="/Profile/Index"
               class="profile-area desktop-profile">

                <img src="@fotoPerfil"
                     class="profile-pic">

                <div class="profile-name">
                    @usuario
                </div>

            </a>

            <!-- MENU -->

            <div class="menu-toggle"
                 onclick="toggleMenu()">

                ☰

            </div>

        </div>

    </div>

    <!-- MENU MOBILE -->

    <div class="mobile-menu"
         id="mobileMenu">

        <div class="mobile-search">

            <div class="search-container mobile-search-container">

                <button id="mobileSearchToggle"
                        class="search-toggle">

                    🔍

                </button>

                <input type="text"
                       id="mobileSearchInput"
                       class="search-input"
                       placeholder="Buscar filmes...">

                <div id="mobileSearchResults"
                     class="search-results">
                </div>

            </div>

        </div>

        <a href="/Profile/Index"
           class="mobile-profile-link">

            <img src="@fotoPerfil"
                 class="profile-pic">

            <span>@usuario</span>

        </a>

        <a href="/Auth/Logout">
            🚪 Sair
        </a>

    </div>

    <!-- HERO -->

    <div class="hero">

        <h1>
            LUMIX PLAY
        </h1>

        <p>
            Filmes, séries, novelas e desenhos em uma experiência moderna
            de streaming inspirada nas maiores plataformas do mundo.
        </p>

        <button class="btn">
            ▶ Assistir Agora
        </button>

    </div>

</body>

</html>
