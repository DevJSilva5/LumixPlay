</head>

<body>

    <!-- NAVBAR -->

    <div class="navbar">

        <div class="logo">
            <img src="/images/logo.png" alt="Lumix Logo">
        </div>

        <a href="/Profile/Index"
               class="profile-area">

            <img src="@fotoPerfil"
                 class="profile-pic">

            <div class="profile-name">
                @usuario
            </div>

        </a>

    </div>

    <!-- HERO -->

    <div class="hero">

        <h1>
            LUMIX PLAY
        </h1>

        <p>
            Filmes, séries, novelas e desenhos em uma experiência moderna
            de streaming inspirada nas maiores plataformas do mundo.
        </p>

        <button class="btn">
            ▶ Assistir Agora
        </button>

    </div>

    <!-- POPULARES -->

    <div class="section">

        <div class="section-title">
            Populares
        </div>

        <div class="slider-container">

            <button class="arrow left"
                    onclick="scrollLeftRow('popular')">
                ❮
            </button>

            <div class="movies-row"
                 id="popular">

                @foreach (var filme in populares.EnumerateArray().Take(12))
                {
                    var titulo = filme.GetProperty("title").GetString();
                    var poster = filme.GetProperty("poster_path").GetString();

                    <div class="card">

                        <img src="https://image.tmdb.org/t/p/w500@(poster)">

                        <div class="card-title">
                            @titulo
                        </div>

                    </div>
                }

            </div>

            <button class="arrow right"
                    onclick="scrollRightRow('popular')">
                ❯
            </button>

        </div>

    </div>

    <!-- AÇÃO -->

    <div class="section">

        <div class="section-title">
            Ação
        </div>

        <div class="slider-container">

            <button class="arrow left"
                    onclick="scrollLeftRow('acao')">
                ❮
            </button>

            <div class="movies-row"
                 id="acao">

                @foreach (var filme in acao.EnumerateArray().Take(12))
                {
                    var titulo = filme.GetProperty("title").GetString();
                    var poster = filme.GetProperty("poster_path").GetString();

                    <div class="card">

                        <img src="https://image.tmdb.org/t/p/w500@(poster)">

                        <div class="card-title">
                            @titulo
                        </div>

                    </div>
                }

            </div>

            <button class="arrow right"
                    onclick="scrollRightRow('acao')">
                ❯
            </button>

        </div>

    </div>

    <!-- ROMANCE -->

    <div class="section">

        <div class="section-title">
            Romance
        </div>

        <div class="slider-container">

            <button class="arrow left"
                    onclick="scrollLeftRow('romance')">
                ❮
            </button>

            <div class="movies-row"
                 id="romance">

                @foreach (var filme in romance.EnumerateArray().Take(12))
                {
                    var titulo = filme.GetProperty("title").GetString();
                    var poster = filme.GetProperty("poster_path").GetString();

                    <div class="card">

                        <img src="https://image.tmdb.org/t/p/w500@(poster)">

                        <div class="card-title">
                            @titulo
                        </div>

                    </div>
                }

            </div>

            <button class="arrow right"
                    onclick="scrollRightRow('romance')">
                ❯
            </button>

        </div>

    </div>

    <!-- COMÉDIA -->

    <div class="section">

        <div class="section-title">
            Comédia
        </div>

        <div class="slider-container">

            <button class="arrow left"
                    onclick="scrollLeftRow('comedia')">
                ❮
            </button>

            <div class="movies-row"
                 id="comedia">

                @foreach (var filme in comedia.EnumerateArray().Take(12))
                {
                    var titulo = filme.GetProperty("title").GetString();
                    var poster = filme.GetProperty("poster_path").GetString();

                    <div class="card">

                        <img src="https://image.tmdb.org/t/p/w500@(poster)">

                        <div class="card-title">
                            @titulo
                        </div>

                    </div>
                }

            </div>

            <button class="arrow right"
                    onclick="scrollRightRow('comedia')">
                ❯
            </button>

        </div>

    </div>

    <script>

            function scrollLeftRow(id) {

                const row = document.getElementById(id);

                row.scrollBy({
                    left: -1000,
                    behavior: 'smooth'
                });
            }

            function scrollRightRow(id) {

                const row = document.getElementById(id);

                row.scrollBy({
                    left: 1000,
                    behavior: 'smooth'
                });
            }

    </script>

</body>

</html>