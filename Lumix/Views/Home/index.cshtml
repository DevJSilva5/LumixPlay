@using System.Text.Json

@{
    Layout = null;
    ViewData["Title"] = "Lumix";

    var populares = ((JsonDocument)ViewBag.Populares)
        .RootElement
        .GetProperty("results");

    var acao = ((JsonDocument)ViewBag.Acao)
        .RootElement
        .GetProperty("results");

    var romance = ((JsonDocument)ViewBag.Romance)
        .RootElement
        .GetProperty("results");

    var comedia = ((JsonDocument)ViewBag.Comedia)
        .RootElement
        .GetProperty("results");

    var usuario = Context.Session.GetString("Usuario") ?? "Usuário";

    var fotoPerfil = Context.Session.GetString("FotoPerfil");

    if (string.IsNullOrEmpty(fotoPerfil))
    {
        fotoPerfil = "/images/perfil-default.png";
    }
}

<!DOCTYPE html>
